# Development and production share the user-selected application database.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
MONGODB_URI=
MONGODB_DB=saraswathi_puja

# Production requires APP_ENV=production, an HTTPS origin and
# MONGODB_DB=saraswathi_puja with a database-scoped Atlas account.
# Do not store the administrator password in an environment file.
